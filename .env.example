# Postgres connection string (Railway injects this when you attach a Postgres service)
DATABASE_URL=postgres://coach:coach@localhost:5432/consultingcoach

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Claude API key. Required in production (AI features are off without it).
# Leave empty in development to use practice mode (scripted responses).
ANTHROPIC_API_KEY=

# Password for the seeded demo account (priya@demo.consultingcoach.app). Defaults to "coachdemo" locally.
# DEMO_PASSWORD=

# Optional: require this code to sign up (invite-only assessments)
# SIGNUP_ACCESS_CODE=

# Comma-separated emails of users who can create and review interview assessments (/assess)
# ASSESSOR_EMAILS=

# Optional overrides
# AI_MODEL=claude-opus-5
# AI_MOCK=1   # force mock mode even when a key is set
